# Prevent aggressive caching of the main HTML file so updates are immediately visible on new deployments
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Cache static assets like JS, CSS, and images which have versioned hashes aggressively
/assets/*
  Cache-Control: public, max-age=31536000, immutable
